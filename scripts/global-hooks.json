{
  "description": "Record agent pushes in Asana and apply Clarity to reader-facing text.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{python} {hook_dir}/asana_push_hook.py --global",
            "timeout": 10,
            "statusMessage": "Checking pushed commits against Asana"
          }
        ],
        "matcher": "startup|resume"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "{python} {hook_dir}/clarity_hook.py --global",
            "timeout": 10,
            "statusMessage": "Applying Clarity to reader-facing text",
            "additionalContextLimit": 5000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{python} {hook_dir}/asana_push_hook.py --global",
            "timeout": 10,
            "statusMessage": "Checking pushed commits against Asana"
          }
        ],
        "matcher": "^(Bash|exec_command|functions.exec|functions.exec_command|write_stdin|functions.write_stdin)$"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "{python} {hook_dir}/clarity_hook.py --global",
            "timeout": 10,
            "statusMessage": "Applying Clarity to reader-facing text",
            "additionalContextLimit": 5000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{python} {hook_dir}/asana_push_hook.py --global",
            "timeout": 10,
            "statusMessage": "Checking pushed commits against Asana"
          }
        ],
        "matcher": "^(Bash|exec_command|functions.exec|functions.exec_command|write_stdin|functions.write_stdin)$|.*asana_get_task$|.*asana_update_tasks$"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{python} {hook_dir}/asana_push_hook.py --global",
            "timeout": 10,
            "statusMessage": "Checking pushed commits against Asana"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "{python} {hook_dir}/clarity_hook.py --global",
            "timeout": 10,
            "statusMessage": "Applying Clarity to reader-facing text"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{python} {hook_dir}/clarity_hook.py --global",
            "timeout": 10,
            "statusMessage": "Applying Clarity to reader-facing text",
            "additionalContextLimit": 5000
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{python} {hook_dir}/clarity_hook.py --global",
            "timeout": 10,
            "statusMessage": "Applying Clarity to reader-facing text",
            "additionalContextLimit": 5000
          }
        ]
      }
    ]
  }
}
